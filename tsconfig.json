{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js": ["src/vendor/firebase-app"],
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js": ["src/vendor/firebase-auth"],
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js": ["src/vendor/firebase-firestore"]
    }
  },
  "include": ["src"]
}
